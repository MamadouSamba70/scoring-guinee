# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Moteur de Scoring Crédit Guinée"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true

# ─── Base de données PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=scoring_guinee
POSTGRES_USER=scoring_user
POSTGRES_PASSWORD=scoring_secret
DATABASE_URL=postgresql+asyncpg://scoring_user:scoring_secret@db:5432/scoring_guinee

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@redis:6379/0

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION_USE_256_BIT_RANDOM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ─── ML ───────────────────────────────────────────────────────────────────────
ML_MODELS_PATH=/app/ml_models
MLFLOW_TRACKING_URI=sqlite:///ml_models/mlflow.db

# ─── PDF ──────────────────────────────────────────────────────────────────────
PDF_OUTPUT_PATH=/tmp/reports

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
